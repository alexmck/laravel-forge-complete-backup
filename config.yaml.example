# Preferred daily times for the setup wizard; saving YAML alone does not update cron.
setup_schedule:
  backup: "03:00"
  maintenance: "05:00"

global:
  server_id: forge-server-1  # Keep stable; unique per server/repository.
  discord_webhook_url: ""
  success_notification: true
  summary_notification: true
  # Disk-backed directory, owned by the scheduled-job user. Do not use tmpfs.
  work_dir: /home/forge/laravel-forge-complete-backup/.backup-work
  min_free_mb: 1024
  restic:
    binary: /home/forge/laravel-forge-complete-backup/bin/restic
    repository: s3:https://ACCOUNT.r2.cloudflarestorage.com/BUCKET/forge-server-1
    region: auto
    environment_file: /home/forge/laravel-forge-complete-backup/restic.env
    password_file: /home/forge/laravel-forge-complete-backup/restic-password
    cpu_cores: 1
    connections: 2
    timeout_seconds: 7200
    check_interval_days: 7
    check_subsets: 4  # Weekly structural check plus rotating quarter of stored data.
    prune_interval_days: 7
    max_repack_size: 128M

defaults:
  backup_database: true
  retention:
    daily: 7
    weekly: 4
    monthly: 12

sites:
  - name: website1-com
    user_path: /home/www-website1-com
    # Automatic discovery: .env or public/{wp-config.php,LocalSettings.php,conf_global.php}.
    # For other layouts, select the exact file:
    # database:
    #   config_file: /home/www-website1-com/current/.env
    #   timeout_seconds: 1800
    # Or provide a private [client] option file and the database name:
    # database:
    #   option_file: /home/forge/.mysql-backup.cnf
    #   name: website1
    #   dump_binary: mariadb-dump  # Default: mysqldump
    exclude_patterns:
      - "*.log"  # Basename patterns match at every depth within this site.
      - "storage/logs"  # Patterns containing / are relative to user_path.
      - "bootstrap/cache"
      - "node_modules"
  - name: static-site
    user_path: /home/static-site
    backup_database: false
    success_notification: false
    retention:
      daily: 14
